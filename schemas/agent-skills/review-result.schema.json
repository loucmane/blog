{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loucmane/blog/schemas/agent-skills/review-result.schema.json",
  "title": "Cross-Agent Skill Review Result",
  "description": "Structural advisory review contract; consumers must assert date-time formats, including calendar validity. Validation does not verify evidence truth, referenced commits, files, commands, URLs, category accuracy or reviewer authority. See docs/agent-skills/review-result-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "skill",
    "mode",
    "verdict",
    "summary",
    "generatedAt",
    "headSha",
    "findings",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "const": "advisory"
    },
    "verdict": {
      "enum": ["pass", "warn", "fail", "not-applicable"],
      "description": "not-applicable requires no findings. For compatibility, pass/warn/fail are reviewer summaries independent of finding severity and blocking flags; no enforcement is inferred."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "RFC 3339 profile with a real calendar date, mandatory seconds and timezone, optional fractions, T/t and Z/z. Leap seconds are excluded for compatibility with the original runtime. Enable full date-time format assertion, not annotation-only or regex-only validation."
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "message",
          "subjective",
          "blocking",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "subjective": {
            "type": "boolean"
          },
          "blocking": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "description": "May be empty for compatibility. References are non-empty strings, not verified evidence or resolved links.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["subjective"],
              "properties": { "subjective": { "const": true } }
            },
            "then": {
              "properties": { "blocking": { "const": false } }
            }
          },
          {
            "if": {
              "required": ["blocking"],
              "properties": { "blocking": { "const": true } }
            },
            "then": {
              "properties": {
                "category": {
                  "enum": [
                    "schema", "link", "script", "test", "build", "typecheck",
                    "lint", "security", "accessibility", "performance-budget",
                    "health", "critical-browser"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "enum": ["command", "file", "url"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "if": {
    "required": ["verdict"],
    "properties": { "verdict": { "const": "not-applicable" } }
  },
  "then": {
    "properties": { "findings": { "maxItems": 0 } }
  }
}
