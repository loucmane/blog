{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "AEGIS_INVOKING_AGENT=codex \"$(git rev-parse --show-toplevel)/.aegis/bin/aegis\" hook posttooluse",
            "statusMessage": "Recording Aegis tracking",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "AEGIS_INVOKING_AGENT=codex \"$(git rev-parse --show-toplevel)/.aegis/bin/aegis\" hook record",
            "statusMessage": "Recording Aegis evidence",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|mcp__.*)$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "'/home/loucmane/gascity/bin/gc' --city '/home/loucmane/gascity/city' handoff --auto --hook-format codex \"context cycle\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "AEGIS_INVOKING_AGENT=codex \"$(git rev-parse --show-toplevel)/.aegis/bin/aegis\" hook sessionstart",
            "statusMessage": "Loading Aegis brief and session evidence",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "GC_MANAGED_SESSION_HOOK=1 GC_HOOK_EVENT_NAME=SessionStart '/home/loucmane/gascity/bin/gc' --city '/home/loucmane/gascity/city' prime --hook --hook-format codex",
            "type": "command"
          }
        ],
        "matcher": "startup"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "AEGIS_INVOKING_AGENT=codex \"$(git rev-parse --show-toplevel)/.aegis/bin/aegis\" hook subagentstart",
            "statusMessage": "Recording Aegis subagent start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "AEGIS_INVOKING_AGENT=codex \"$(git rev-parse --show-toplevel)/.aegis/bin/aegis\" hook recordjson",
            "statusMessage": "Recording Aegis subagent completion",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/home/loucmane/gascity/bin/gc' --city '/home/loucmane/gascity/city' hook run --timeout 15s --timeout-exit-code 0 -- nudge drain --inject --hook-format codex",
            "type": "command"
          },
          {
            "command": "'/home/loucmane/gascity/bin/gc' --city '/home/loucmane/gascity/city' hook run --timeout 15s --timeout-exit-code 0 -- mail check --inject --hook-format codex",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
