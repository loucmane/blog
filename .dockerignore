# Admit only the inputs needed by the web build and migration command.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/
packages/**
!packages/web/
packages/web/**
!packages/web/package.json
!packages/web/next.config.ts
!packages/web/postcss.config.mjs
!packages/web/tsconfig.json
!packages/web/src/
!packages/web/src/**
!packages/web/public/
!packages/web/public/**
!packages/web/scripts/
packages/web/scripts/**
!packages/web/scripts/migrate.mjs
!packages/web/migrations/
packages/web/migrations/**
!packages/web/migrations/*.sql

# The web tree also contains browser and integration-only harnesses whose
# TypeScript imports point outside the production build inputs.
**/*.test.*
**/*.spec.*
**/*.e2e.*
packages/web/src/reader-directions/**/playwright.config.ts
packages/web/src/server/database/lab-seed-integration.ts
packages/web/src/server/database/lab-seed-concurrency-integration.ts

# Keep local files out even when they are under an admitted directory.
**/.env*
**/*.env
**/*.env.*
**/.npmrc
**/.yarnrc*
**/.git
**/.beads
**/.gc
**/.gascity
**/.aegis
**/.codex
**/.aws
**/.ssh
**/credentials*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.local
**/.next
**/node_modules
**/ci-artifacts
**/coverage
**/worktrees
